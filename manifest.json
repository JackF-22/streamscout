{
  "manifest_version": 3,
  "name": "StreamScout",
  "version": "1.0.0",
  "description": "Find where a movie, show, or live game is streaming \u2014 free, subscription, rent, or buy \u2014 and jump straight to it.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.themoviedb.org/*",
    "https://site.api.espn.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "StreamScout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open StreamScout"
    }
  },
  "options_page": "options/options.html"
}